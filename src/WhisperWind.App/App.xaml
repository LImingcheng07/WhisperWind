<Application x:Class="WhisperWind.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:WhisperWind.App.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Themes/Fluent/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToBrushConverter x:Key="BoolToBrush"
                                             True="#7DBB6B"
                                             False="#9A8866" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisible" />
            <converters:BoolToVisibilityConverter x:Key="InverseVisible" Invert="True" />
            <converters:NotBoolConverter x:Key="NotBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

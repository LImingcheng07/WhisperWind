<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:WhisperWind.App.Controls">

    <!-- ===== 设计稿 v6 · 宣纸水墨配色 ===== -->
    <Color x:Key="PaperColor">#F3EEE3</Color>
    <SolidColorBrush x:Key="PaperBrush" Color="#F3EEE3" />
    <SolidColorBrush x:Key="PaperDeepBrush" Color="#EDE5D3" />
    <SolidColorBrush x:Key="CardBrush" Color="#FAF6EE" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F4EDDF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E6DCC8" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E8DECB" />
    <SolidColorBrush x:Key="InkBrush" Color="#2B2A26" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="#8A7F6A" />
    <SolidColorBrush x:Key="InkFaintBrush" Color="#B5AA93" />
    <SolidColorBrush x:Key="SealBrush" Color="#C0463A" />
    <SolidColorBrush x:Key="SealDeepBrush" Color="#A23A30" />
    <SolidColorBrush x:Key="SealSoftBrush" Color="#F6E3DD" />
    <SolidColorBrush x:Key="TerracottaBrush" Color="#D98A6A" />
    <SolidColorBrush x:Key="GoldBrush" Color="#B8943F" />
    <SolidColorBrush x:Key="SageBrush" Color="#7F9A74" />
    <SolidColorBrush x:Key="SageSoftBrush" Color="#E4EADD" />
    <SolidColorBrush x:Key="MountainNearBrush" Color="#A9B89E" />
    <SolidColorBrush x:Key="MountainFarBrush" Color="#C9D3C0" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#F8EAD6" />

    <FontFamily x:Key="SerifFont">Noto Serif SC, Source Han Serif SC, SimSun</FontFamily>
    <FontFamily x:Key="SansFont">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="LatinFont">Georgia</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#6B5A3A" />
    <DropShadowEffect x:Key="SealShadow" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#C0463A" />

    <!-- 卡片 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <!-- 小标签 -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="#F0E7D5" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 键帽 -->
    <Style x:Key="Kbd" TargetType="Border">
        <Setter Property="Background" Value="#FFFDF8" />
        <Setter Property="BorderBrush" Value="#D9CCB0" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 文字 -->
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="Serif" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style x:Key="Caps" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LatinFont}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Serif}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 小节标题：「标题 ———」 -->
    <Style x:Key="Section" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Content}" FontFamily="{StaticResource SerifFont}"
                                   FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                        <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Tag}" VerticalAlignment="Center" />
                        <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="12,1,12,0" VerticalAlignment="Center" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 左侧栏目导航 -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="GroupName" Value="Nav" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="10" Padding="12,9" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Num" Text="{Binding (c:Ex.Numeral), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource SerifFont}" FontSize="12" Width="22" Foreground="{StaticResource InkFaintBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="Ic" Text="{Binding (c:Ex.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       Style="{StaticResource Icon}" FontSize="15" Width="28" Foreground="{StaticResource InkSoftBrush}" />
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" FontFamily="{StaticResource SerifFont}" FontSize="15"
                                       Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1E6D4" />
                            <Setter TargetName="Num" Property="Foreground" Value="{StaticResource GoldBrush}" />
                            <Setter TargetName="Ic" Property="Foreground" Value="{StaticResource SealBrush}" />
                            <Setter TargetName="Tx" Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 圆形图标按钮（上一首/停止/下一首） -->
    <Style x:Key="RoundButton" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="#D9CCB0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="El" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="El" Property="Fill" Value="{StaticResource PaperDeepBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="El" Property="Fill" Value="#E4D9C3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 朱红大播放键 -->
    <Style x:Key="PlayButton" TargetType="Button">
        <Setter Property="Width" Value="62" />
        <Setter Property="Height" Value="62" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="El" Effect="{StaticResource SealShadow}">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.35,0.3">
                                    <GradientStop Color="#E0705F" Offset="0" />
                                    <GradientStop Color="#C0463A" Offset="0.75" />
                                    <GradientStop Color="#A93B30" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="El" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" CenterX="31" CenterY="31" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 胶囊按钮 -->
    <Style x:Key="Pill" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="#D9CCB0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="15" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <TextBlock x:Name="Ic" Text="{Binding (c:Ex.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ex.Icon" Value="">
                            <Setter TargetName="Ic" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PaperDeepBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E4D9C3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentPill" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource SealBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SealDeepBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="15" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <TextBlock x:Name="Ic" Text="{Binding (c:Ex.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ex.Icon" Value="">
                            <Setter TargetName="Ic" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SealDeepBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 纯文字/图标小按钮 -->
    <Style x:Key="Ghost" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PaperDeepBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标题栏按钮 -->
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <!-- 列表行（可点） -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段切换（筛选标签） -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="13" Padding="12,4" Background="Transparent" BorderBrush="#D9CCB0" BorderThickness="1">
                        <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" FontFamily="{StaticResource SansFont}" FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource InkBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InkBrush}" />
                            <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource CardBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 输入框 -->
    <Style x:Key="PaperTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource SealBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource TerracottaBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="#FFFDF8" BorderBrush="#D9CCB0" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <TextBlock x:Name="Ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource InkFaintBrush}"
                                       FontSize="{TemplateBinding FontSize}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SealBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滑块：青绿轨道 + 金边圆钮 -->
    <Style x:Key="SliderRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PaperSlider" TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeat}" Background="{StaticResource SageBrush}" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeat}" Background="#DCD2BE" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Width="18" Height="18">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse Fill="#FFFDF8" Stroke="{StaticResource GoldBrush}" StrokeThickness="2.5" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ProgressSlider" TargetType="Slider" BasedOn="{StaticResource PaperSlider}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeat}" Background="{StaticResource SealBrush}" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeat}" Background="#E3D9C5" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Width="14" Height="14">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse Fill="#FFFDF8" Stroke="{StaticResource SealBrush}" StrokeThickness="2.5" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 勾选框 -->
    <Style x:Key="PaperCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" BorderBrush="#C9BB9C" Background="#FFFDF8">
                            <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource SealBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SealBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 远山：窗口和舞台的背景 -->
    <DrawingBrush x:Key="MountainsBrush" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 L1000,0 L1000,300 L0,300 Z" />
                <GeometryDrawing Brush="#55C9D3C0"
                                 Geometry="M0,300 L0,170 L90,120 L170,160 L260,80 L360,150 L450,110 L560,170 L650,90 L760,150 L860,100 L1000,160 L1000,300 Z" />
                <GeometryDrawing Brush="#66B7C4AA"
                                 Geometry="M0,300 L0,220 L120,170 L210,210 L330,150 L430,215 L540,175 L640,225 L760,170 L880,215 L1000,185 L1000,300 Z" />
                <GeometryDrawing Brush="#80A9B89E"
                                 Geometry="M0,300 L0,262 L150,228 L280,258 L420,222 L560,262 L700,232 L850,265 L1000,240 L1000,300 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>

<Page x:Class="WhisperWind.App.Views.NowPlayingView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:WhisperWind.App.ViewModels"
      Title="此刻吹"
      d:DataContext="{d:DesignInstance vm:MainViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 状态 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🍃 此刻吹" FontSize="28" Foreground="#E6D9B0" FontWeight="SemiBold" />
            <TextBlock Text=" · " FontSize="28" Foreground="#7A8E70" />
            <TextBlock Text="{Binding StatusText}" FontSize="18" Foreground="#9FA88F" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 中央：演奏 + 控制 -->
        <Border Grid.Row="1" CornerRadius="16" Background="#22301F" Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="🎵"
                           FontSize="120" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#C9A961" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Content="⏮ 上一首" Margin="6" Padding="14,8" />
                    <Button Content="{Binding PlayButtonText}"
                            Margin="6" Padding="20,8"
                            Background="#C9A961" Foreground="White" BorderThickness="0"
                            Command="{Binding PlayOrToggleCommand}" />
                    <Button Content="⏹ 停止 (F10)" Margin="6" Padding="14,8"
                            Command="{Binding StopCommand}" />
                    <Button Content="⏭ 下一首" Margin="6" Padding="14,8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部：曲目 + 目标窗口 + 速度 -->
        <Border Grid.Row="2" CornerRadius="12" Background="#1F2A1C" Padding="20" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding CurrentTrackText, StringFormat='当前曲目: {0}'}"
                               FontSize="16" Foreground="#E6D9B0" />
                    <TextBlock Text="F8 演奏/继续 · F9 暂停 · F10 强停"
                               FontSize="12" Foreground="#7A8E70" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="目标窗口: " Foreground="#9FA88F" />
                    <Border Background="{Binding IsTargetFocused, Converter={StaticResource BoolToBrushConverter}}"
                            CornerRadius="8" Padding="8,4">
                        <TextBlock Text="{Binding TargetWindowText}" Foreground="White" FontSize="12" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 错误提示 -->
        <Border Grid.Row="2" CornerRadius="8" Background="#7A2E1F" Padding="12" Margin="0,80,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠ " Foreground="#FFC9B0" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFC9B0" />
                <Button Content="×" Background="Transparent" Foreground="#FFC9B0" BorderThickness="0"
                        Margin="12,0,0,0" Command="{Binding DismissErrorCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>

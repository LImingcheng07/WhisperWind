<Page x:Class="WhisperWind.App.Views.NowPlayingView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="此刻吹">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 状态 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🍃 此刻吹" FontSize="28" Foreground="#E6D9B0" FontWeight="SemiBold" />
            <TextBlock Text=" · " FontSize="28" Foreground="#7A8E70" />
            <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="18" Foreground="#9FA88F" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 中央：口琴 + 控制 -->
        <Border Grid.Row="1" CornerRadius="16" Background="#22301F" Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 口琴示意（占位） -->
                <TextBlock Grid.Row="0" Text="🎵"
                           FontSize="120" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#C9A961" />

                <!-- 播放控制 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <ui:Button Content="⏮ 上一首" Margin="6" Padding="14,8" />
                    <ui:Button x:Name="PlayBtn" Content="▶ 演奏 F8" Appearance="Primary" Margin="6" Padding="20,8" Click="PlayBtn_Click" />
                    <ui:Button Content="⏹ 停止 F9" Margin="6" Padding="14,8" />
                    <ui:Button Content="⏭ 下一首" Margin="6" Padding="14,8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部：曲目信息 -->
        <Border Grid.Row="2" CornerRadius="12" Background="#1F2A1C" Padding="20" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TrackTitle" Text="鸟之诗 · Air" FontSize="18" Foreground="#E6D9B0" />
                    <TextBlock x:Name="TrackInfo" Text="120 BPM · 4 段 · 454 音符" FontSize="13" Foreground="#7A8E70" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="目标窗口: " Foreground="#9FA88F" />
                    <ui:Badge x:Name="TargetBadge" Content="未锁定" Appearance="Caution" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

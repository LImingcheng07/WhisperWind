<Page x:Class="WhisperWind.App.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="设置"
      Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Text="⚙ 设置" FontSize="28" FontWeight="Bold" Foreground="#C9A961" Margin="0,0,0,16" />

            <TextBlock Text="🤖 AI 知音" FontSize="18" FontWeight="SemiBold" Foreground="#A0392F" Margin="0,16,0,8" />

            <TextBlock Text="Provider（API 提供方）" Foreground="#1F2818" Margin="0,8,0,4" />
            <ComboBox x:Name="ProviderCombo" Height="36" SelectionChanged="OnProviderChanged">
                <ComboBoxItem Content="Anthropic Claude" Tag="anthropic" />
                <ComboBoxItem Content="OpenAI" Tag="openai" />
                <ComboBoxItem Content="OpenAI 兼容（自定义端点）" Tag="custom" />
            </ComboBox>

            <!-- Anthropic -->
            <StackPanel x:Name="AnthropicPanel" Margin="0,8,0,0">
                <TextBlock Text="Anthropic API Key" Foreground="#1F2818" Margin="0,8,0,4" />
                <PasswordBox x:Name="AnthropicKeyBox" Height="36" />
            </StackPanel>

            <!-- OpenAI -->
            <StackPanel x:Name="OpenAIPanel" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Text="OpenAI API Key" Foreground="#1F2818" Margin="0,8,0,4" />
                <PasswordBox x:Name="OpenAIKeyBox" Height="36" />
                <TextBlock Text="默认模型（可改）：gpt-4o-mini / gpt-4o / gpt-3.5-turbo" Foreground="#7A7060" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Custom (OpenAI 兼容) -->
            <StackPanel x:Name="CustomPanel" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Text="端点 URL" Foreground="#1F2818" Margin="0,8,0,4" />
                <TextBox x:Name="CustomEndpointBox" Height="32" />
                <TextBlock Text="API Key" Foreground="#1F2818" Margin="0,8,0,4" />
                <PasswordBox x:Name="CustomKeyBox" Height="36" />
                <TextBlock Text="支持 OpenAI 格式 API：OpenRouter / DeepSeek / Ollama / 中转站 / 自建 LLM。" Foreground="#7A7060" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="模型" Foreground="#1F2818" Margin="0,12,0,4" />
            <TextBox x:Name="ModelBox" Height="32" />

            <Button Content="💾 保存设置" Height="42" Margin="0,20,0,0" Background="#A0392F" Foreground="#FFFBF0"
                    FontSize="15" FontWeight="SemiBold" Click="OnSaveClick"
                    BorderThickness="0" Cursor="Hand" />

            <TextBlock x:Name="StatusText" Foreground="#3D5C3A" Margin="0,8,0,0" TextWrapping="Wrap" />

            <Border BorderBrush="#C9A961" BorderThickness="0,1,0,0" Margin="0,32,0,0" />

            <TextBlock Text="📚 在线曲库" FontSize="18" FontWeight="SemiBold" Foreground="#A0392F" Margin="0,16,0,8" />

            <TextBlock Text="Provider" Foreground="#1F2818" Margin="0,8,0,4" />
            <ComboBox x:Name="OnlineProviderCombo" Height="36" SelectionChanged="OnOnlineProviderChanged">
                <ComboBoxItem Content="BitMidi.com（默认，15000+ 流行/动漫/影视）" Tag="bitmidi" />
                <ComboBoxItem Content="MIDIss.com（少量但稳定）" Tag="midisss" />
                <ComboBoxItem Content="自定义 JSON URL" Tag="custom" />
            </ComboBox>

            <StackPanel x:Name="CustomIndexPanel" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Text="自定义索引 URL（JSON 数组）" Foreground="#1F2818" Margin="0,8,0,4" />
                <TextBox x:Name="CustomIndexBox" Height="32" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

<ui:FluentWindow x:Class="WhisperWind.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:WhisperWind.App.Views"
        Title="风声未止 · 三角洲自动口琴"
        Height="720" Width="1180"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏（国风风） -->
        <ui:NavigationView x:Name="RootNav" Grid.Column="0"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="200"
                           Background="#0F1A14"
                           Frame="{Binding ElementName=ContentFrame}">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="此刻吹" TargetPageType="{x:Type views:NowPlayingView}" Icon="{ui:SymbolIcon Play24}" />
                <ui:NavigationViewItem Content="曲库"   TargetPageType="{x:Type views:LibraryView}"  Icon="{ui:SymbolIcon MusicNote224}" />
                <ui:NavigationViewItem Content="知音"   TargetPageType="{x:Type views:AIView}"       Icon="{ui:SymbolIcon BrainCircuit24}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="关于" TargetPageType="{x:Type views:AIView}" Icon="{ui:SymbolIcon Info24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- 右侧内容（Frame 切换三页） -->
        <Grid Grid.Column="1" Background="#1A2419">
            <Frame x:Name="ContentFrame" />
        </Grid>
    </Grid>
</ui:FluentWindow>

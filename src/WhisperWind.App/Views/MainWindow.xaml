<ui:FluentWindow x:Class="WhisperWind.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:WhisperWind.App.Views"
        Title="风声未止 · 三角洲自动口琴"
        Height="720" Width="1180"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 + 右侧内容由 NavigationView 内部 NavigationViewContentPresenter 托管 -->
        <ui:NavigationView x:Name="RootNav" Grid.Column="0" Grid.ColumnSpan="2"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="200"
                           Background="#0F1A14">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="此刻吹" TargetPageType="{x:Type views:NowPlayingView}" Icon="{ui:SymbolIcon Play24}" />
                <ui:NavigationViewItem Content="曲库"   TargetPageType="{x:Type views:LibraryView}"  Icon="{ui:SymbolIcon MusicNote224}" />
                <ui:NavigationViewItem Content="知音"   TargetPageType="{x:Type views:AIView}"       Icon="{ui:SymbolIcon BrainCircuit24}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="设置" TargetPageType="{x:Type views:SettingsView}" Icon="{ui:SymbolIcon Settings24}" />
                <ui:NavigationViewItem Content="关于" TargetPageType="{x:Type views:AIView}"        Icon="{ui:SymbolIcon Info24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>

<Window x:Class="WhisperWind.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WhisperWind.App.Controls"
        xmlns:p="clr-namespace:WhisperWind.App.Views.Pages"
        xmlns:cv="clr-namespace:WhisperWind.App.Converters"
        Title="风声未止 · WhisperWind"
        Width="1360" Height="860" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PaperBrush}"
        FontFamily="{StaticResource SansFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- 纸面 + 远山 -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F6F2E9" Offset="0" />
                <GradientStop Color="#F1EBDD" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Rectangle Fill="{StaticResource MountainsBrush}" VerticalAlignment="Bottom" Height="360" IsHitTestVisible="False" Opacity="0.9" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- ===== 标题栏 ===== -->
            <Grid Grid.Row="0" Margin="28,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="6" Background="{StaticResource SealBrush}" VerticalAlignment="Center"
                        Effect="{StaticResource SealShadow}">
                    <TextBlock Text="风&#10;声" Foreground="White" FontFamily="{StaticResource SerifFont}" FontSize="14" FontWeight="Bold"
                               LineHeight="16" LineStackingStrategy="BlockLineHeight" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="风声未止" Style="{StaticResource Serif}" FontSize="24" FontWeight="Bold" />
                    <TextBlock Style="{StaticResource Caps}" Margin="1,1,0,0">
                        <Run Text="WhisperWind · delta force auto harmonica ·" />
                        <Run Text="{Binding Version, Mode=OneTime}" />
                    </TextBlock>
                </StackPanel>

                <!-- 状态签 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0" ToolTip="游戏窗口状态">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding GameFound, Converter={StaticResource BoolToBrush}}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding GameStatusText}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0" ToolTip="游戏若以管理员运行，风声也需要管理员权限才能发送按键">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding IsAdmin, Converter={StaticResource BoolToBrush}}" Margin="0,0,6,0" />
                            <TextBlock Style="{StaticResource Muted}">
                                <TextBlock.Text>
                                    <Binding Path="IsAdmin">
                                        <Binding.Converter>
                                            <cv:BoolTextConverter True="管理员" False="普通权限" />
                                        </Binding.Converter>
                                    </Binding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}" Cursor="Hand" MouseLeftButtonUp="OnCheckChipClick" ToolTip="点击查看自检"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding CheckLevel, Converter={StaticResource CheckLevelToBrush}}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CheckSummary}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource Pill}" c:Ex.Icon="&#xE8A7;" Content="悬浮窗" Margin="10,0,0,0" Padding="12,4"
                            Command="{Binding ToggleOverlayCommand}" ToolTip="游戏内悬浮迷你播放器（F7）"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>

                <!-- 窗口按钮 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="最小化" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="最大化" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <!-- ===== 主体三栏 ===== -->
            <Grid Grid.Row="1" Margin="24,4,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="290" />
                </Grid.ColumnDefinitions>

                <!-- 左：栏目 + 调音 -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="4,4,4,12">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="14,16">
                            <StackPanel>
                                <ContentControl Style="{StaticResource Section}" Content="栏目" Margin="4,0,0,8" />
                                <RadioButton Style="{StaticResource NavItem}" c:Ex.Numeral="壹" c:Ex.Icon="&#xE8D6;" Content="正在吹"
                                             IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=now}" />
                                <RadioButton Style="{StaticResource NavItem}" c:Ex.Numeral="贰" c:Ex.Icon="&#xE8F1;" Content="曲库"
                                             IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=library}" />
                                <RadioButton Style="{StaticResource NavItem}" c:Ex.Numeral="叁" c:Ex.Icon="&#xE774;" Content="在线曲库"
                                             IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=online}" />
                                <RadioButton Style="{StaticResource NavItem}" c:Ex.Numeral="肆" c:Ex.Icon="&#xE8BD;" Content="NPC 歌诀"
                                             IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=npc}" />
                                <RadioButton Style="{StaticResource NavItem}" c:Ex.Numeral="伍" c:Ex.Icon="&#xE9D9;" Content="状态自检"
                                             IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=check}" />
                                <RadioButton Style="{StaticResource NavItem}" c:Ex.Numeral="陆" c:Ex.Icon="&#xE8F2;" Content="知音 AI"
                                             IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=ai}" />
                                <RadioButton Style="{StaticResource NavItem}" c:Ex.Numeral="柒" c:Ex.Icon="&#xE713;" Content="设置"
                                             IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=settings}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <ContentControl Style="{StaticResource Section}" Content="调音" />

                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caps}" FontSize="13">
                                        <Run Text="{Binding Speed, StringFormat={}{0:0.00}}" /><Run Text=" x" />
                                    </TextBlock>
                                    <TextBlock Text="节拍" Style="{StaticResource Body}" />
                                </DockPanel>
                                <Slider Style="{StaticResource PaperSlider}" Minimum="0.5" Maximum="1.5" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Speed}" Margin="0,2,0,8" />

                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caps}" FontSize="13">
                                        <Run Text="{Binding TransposeText, Mode=OneWay}" /><Run Text=" 半音" />
                                    </TextBlock>
                                    <TextBlock Text="移调" Style="{StaticResource Body}" />
                                </DockPanel>
                                <Slider Style="{StaticResource PaperSlider}" Minimum="-24" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"
                                        SmallChange="1" LargeChange="12" IsEnabled="{Binding CanTune}"
                                        Value="{Binding Transpose, Delay=250}" Margin="0,2,0,2" />
                                <Button Style="{StaticResource Ghost}" Content="自动找最佳移调" HorizontalAlignment="Right" FontSize="11"
                                        Command="{Binding AutoTransposeCommand}" IsEnabled="{Binding CanTune}" Margin="0,0,0,6" />

                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caps}" FontSize="13">
                                        <Run Text="{Binding CountdownSeconds, Mode=OneWay}" /><Run Text=" s" />
                                    </TextBlock>
                                    <TextBlock Text="倒计时" Style="{StaticResource Body}" />
                                </DockPanel>
                                <Slider Style="{StaticResource PaperSlider}" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding CountdownSeconds}" Margin="0,2,0,8" />

                                <TextBlock Text="旋律轨" Style="{StaticResource Body}" Margin="0,4,0,4" />
                                <ComboBox ItemsSource="{Binding SongTracks}" SelectedItem="{Binding SelectedTrack}" DisplayMemberPath="DisplayName"
                                          IsEnabled="{Binding CanTune}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 中：页面 -->
                <Grid Grid.Column="1" Margin="14,4,14,0">
                    <p:NowPlayingPage Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisible}, ConverterParameter=now}" />
                    <p:LibraryPage Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisible}, ConverterParameter=library}" />
                    <p:OnlinePage Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisible}, ConverterParameter=online}" />
                    <p:NpcPage Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisible}, ConverterParameter=npc}" />
                    <p:CheckPage Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisible}, ConverterParameter=check}" />
                    <p:AiPage Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisible}, ConverterParameter=ai}" />
                    <p:SettingsPage Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisible}, ConverterParameter=settings}" />
                </Grid>

                <!-- 右：此刻状态 + 山间小调 + NPC 歌诀 -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="4,4,4,12">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <ContentControl Style="{StaticResource Section}" Content="此刻" />
                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Serif}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource SealBrush}" />
                                <TextBlock Text="{Binding StageText}" Style="{StaticResource Muted}" Margin="0,4,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Style="{StaticResource Kbd}"><TextBlock Text="F8" FontSize="11" /></Border>
                                    <TextBlock Text="吹奏 / 暂停" Style="{StaticResource Muted}" Margin="0,0,10,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Style="{StaticResource Kbd}"><TextBlock Text="F9" FontSize="11" /></Border>
                                    <TextBlock Text="停止" Style="{StaticResource Muted}" Margin="0,0,10,0" />
                                    <Border Style="{StaticResource Kbd}"><TextBlock Text="F7" FontSize="11" /></Border>
                                    <TextBlock Text="悬浮窗" Style="{StaticResource Muted}" />
                                </StackPanel>
                                <Border Background="{StaticResource SealSoftBrush}" CornerRadius="8" Padding="10,8" Margin="0,6,0,0"
                                        Visibility="{Binding InputBlocked, Converter={StaticResource BoolToVisible}}">
                                    <StackPanel>
                                        <TextBlock Text="按键被系统拦截" FontWeight="Bold" Style="{StaticResource Body}" Foreground="{StaticResource SealDeepBrush}" />
                                        <TextBlock Text="游戏以管理员运行，需要以管理员身份重启风声。" Style="{StaticResource Muted}" Margin="0,2,0,6" />
                                        <Button Style="{StaticResource AccentPill}" Content="以管理员重启" HorizontalAlignment="Left" Padding="10,3"
                                                Command="{Binding RestartAsAdminCommand}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14,16" Margin="0,14,0,0">
                            <StackPanel>
                                <ContentControl Style="{StaticResource Section}" Content="山间小调" Margin="4,0,0,6" />
                                <ItemsControl ItemsSource="{Binding QuickSongs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Padding="8,8"
                                                    Command="{Binding DataContext.OpenTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource Caps}" FontStyle="Normal" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Serif}" FontSize="14" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caps}" Margin="8,0,8,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14,16" Margin="0,14,0,0">
                            <StackPanel>
                                <ContentControl Style="{StaticResource Section}" Content="NPC 歌诀" Margin="4,0,0,6" />
                                <ItemsControl ItemsSource="{Binding NpcCodes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Padding="8,8" ToolTip="点一下载入，然后按 F8 吹奏"
                                                    Command="{Binding DataContext.PlayNpcCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource SealBrush}" />
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Serif}" FontSize="14" Width="44" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Code}" FontFamily="{StaticResource LatinFont}" FontSize="14" Foreground="{StaticResource GoldBrush}"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== 底栏 ===== -->
            <Grid Grid.Row="2" Margin="30,0,30,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{Binding GameFound, Converter={StaticResource BoolToBrush}}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding GameStatusText}" Style="{StaticResource Caps}" />
                    <TextBlock Text="   |   SendInput 模式 · 不读内存 · 不注入" Style="{StaticResource Caps}" />
                </StackPanel>
                <TextBlock Text="昨夜西风凋碧树 · 独上高楼 · 望尽天涯路" Style="{StaticResource Caps}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Caps}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Run Text="风吹 ·" /><Run Text="{Binding Version, Mode=OneTime}" />
                </TextBlock>
            </Grid>
        </Grid>

        <!-- 提示条 -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,54" Padding="18,10" CornerRadius="20"
                Background="#EE2B2A26" MaxWidth="640" Cursor="Hand" MouseLeftButtonUp="OnToastClick"
                Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="{Binding ToastText}" Foreground="#FAF6EE" FontSize="13" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>

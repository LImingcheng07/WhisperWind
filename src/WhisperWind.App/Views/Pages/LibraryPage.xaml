<UserControl x:Class="WhisperWind.App.Views.Pages.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WhisperWind.App.Controls">
    <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,4,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Ghost}" Content="&#xE72C;" FontFamily="{StaticResource IconFont}" ToolTip="刷新"
                            Command="{Binding RefreshLibraryCmdCommand}" Margin="0,0,6,0" />
                    <Button Style="{StaticResource Pill}" c:Ex.Icon="&#xE838;" Content="打开文件夹" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource AccentPill}" c:Ex.Icon="&#xE8B5;" Content="导入 MIDI" Command="{Binding ImportCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="曲库" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding LibraryCountText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,16,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <RadioButton Style="{StaticResource Segment}" GroupName="LibFilter" Content="全部"
                                 IsChecked="{Binding LibraryFilter, Converter={StaticResource Equals}, ConverterParameter=all}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="LibFilter" Content="内置"
                                 IsChecked="{Binding LibraryFilter, Converter={StaticResource Equals}, ConverterParameter=builtin}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="LibFilter" Content="导入"
                                 IsChecked="{Binding LibraryFilter, Converter={StaticResource Equals}, ConverterParameter=imported}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="LibFilter" Content="在线"
                                 IsChecked="{Binding LibraryFilter, Converter={StaticResource Equals}, ConverterParameter=online}" />
                </StackPanel>
                <TextBox Style="{StaticResource PaperTextBox}" Tag="搜索曲名……" Text="{Binding LibraryQuery, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding LibraryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource RowButton}" ToolTip="{Binding FullPath}"
                                            Command="{Binding DataContext.OpenTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" Foreground="{StaticResource InkFaintBrush}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Serif}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caps}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Chip}" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="{StaticResource InkSoftBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="3" Style="{StaticResource Caps}" FontStyle="Normal" VerticalAlignment="Center">
                                                <Run Text="{Binding NoteCount, Mode=OneWay}" /><Run Text=" 音" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="4" Text="{Binding DurationText}" Style="{StaticResource Caps}" FontStyle="Normal"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                            Width="34" Margin="4,0,0,0" ToolTip="删除"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisible}}"
                                            Command="{Binding DataContext.DeleteTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Border Grid.Column="1" Width="38" Visibility="{Binding CanDelete, Converter={StaticResource InverseVisible}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="没有找到曲子。可以导入本地 MIDI，或去「在线曲库」搜一首。" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,30"
                               Visibility="{Binding LibraryItems.Count, Converter={StaticResource EmptyToVisible}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>

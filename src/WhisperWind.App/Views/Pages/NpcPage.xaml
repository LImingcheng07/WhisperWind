<UserControl x:Class="WhisperWind.App.Views.Pages.NpcPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WhisperWind.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="24,20">
                <StackPanel>
                    <TextBlock Text="NPC 歌诀" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,14"
                               Text="任务 NPC 要求吹的简谱码。点「载入」后切到游戏、拿出口琴，按 F8 开始。数字 1~7 对应口琴 1~7 孔。" />
                    <ItemsControl ItemsSource="{Binding NpcCodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,12,0" Padding="16,14" CornerRadius="12" Background="#FFFDF8" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Serif}" FontSize="18" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Caps}" />
                                        <TextBlock Text="{Binding Code}" FontFamily="{StaticResource LatinFont}" FontSize="24" Foreground="{StaticResource GoldBrush}" Margin="0,10,0,10" />
                                        <Button Style="{StaticResource AccentPill}" c:Ex.Icon="&#xE768;" Content="载入" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.PlayNpcCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,14,0,0">
                <StackPanel>
                    <ContentControl Style="{StaticResource Section}" Content="自定义简谱" />
                    <TextBox Style="{StaticResource PaperTextBox}" Tag="例：1 2 3 1 | 5- 6_5_ 3 1" Text="{Binding CustomJianpu, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top" FontFamily="{StaticResource LatinFont}" FontSize="15" />
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentPill}" c:Ex.Icon="&#xE768;" Content="载入" Command="{Binding LoadCustomJianpuCommand}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="一拍" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Style="{StaticResource PaperSlider}" Width="200" Minimum="150" Maximum="1200" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Value="{Binding CustomBeatMs}" />
                            <TextBlock Style="{StaticResource Caps}" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Run Text="{Binding CustomBeatMs, Mode=OneWay}" /><Run Text=" ms" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <Border Background="{StaticResource PaperDeepBrush}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource Muted}" LineHeight="20">
                            <Run Text="写法：" FontWeight="Bold" />
                            <Run Text="1~7 = do~si　0 = 休止　' = 高八度（1'）　, = 低八度（5,）　# = 升半音（4#）" />
                            <LineBreak />
                            <Run Text="　　　_ = 半拍（可连写 __）　. = 附点　- = 延长一拍　空格 / | 只是分隔" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,14,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" c:Ex.Icon="&#xE765;" Content="按键测试" VerticalAlignment="Center"
                            Command="{Binding KeyTestCommand}" />
                    <StackPanel>
                        <TextBlock Text="按键测试" Style="{StaticResource Serif}" FontSize="15" FontWeight="Bold" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,16,0"
                                   Text="在游戏里从 1 吹到高音 1，确认 8 个键位都能出声。点按钮后切回游戏即开始倒计时。" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

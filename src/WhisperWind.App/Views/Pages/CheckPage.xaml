<UserControl x:Class="WhisperWind.App.Views.Pages.CheckPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WhisperWind.App.Controls">
    <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,4,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentPill}" c:Ex.Icon="&#xE72C;" Content="重新自检" VerticalAlignment="Center"
                        Command="{Binding RunChecksCommand}" />
                <StackPanel>
                    <TextBlock Text="状态自检" Style="{StaticResource PageTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="9" Height="9" Fill="{Binding CheckLevel, Converter={StaticResource CheckLevelToBrush}}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding CheckSummary}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        <TextBlock Text="  · 本地项每 3 秒自动刷新" Style="{StaticResource Muted}" />
                        <TextBlock Text="  · 检测中……" Style="{StaticResource Muted}" Visibility="{Binding ChecksBusy, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="10" Background="#FFFDF8"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top"
                                            Background="{Binding Level, Converter={StaticResource CheckLevelToBrush}}">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource SansFont}" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Serif}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource Pill}" Content="{Binding ActionText}" Margin="12,0,0,0" Padding="12,4"
                                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVisible}}"
                                            Command="{Binding DataContext.RunCheckActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="WhisperWind.App.Views.Pages.AiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WhisperWind.App.Controls">
    <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,4,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="清空对话" VerticalAlignment="Center" Command="{Binding ClearAiCommand}" />
                <StackPanel>
                    <TextBlock Text="知音 AI" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="会结合当前曲目的转换结果回答。API Key 在「设置」里填写。" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ChatMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Bubble" Margin="0,0,80,10" Padding="14,10" CornerRadius="12" Background="#FFFDF8"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                <TextBox Style="{x:Null}" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                         FontFamily="{StaticResource SansFont}" FontSize="13" Foreground="{StaticResource InkBrush}" Padding="0" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Bubble" Property="Margin" Value="80,0,0,10" />
                                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource SealSoftBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentPill}" c:Ex.Icon="&#xE724;" Content="发送" Margin="10,0,0,0"
                        Command="{Binding AskAiCommand}" />
                <TextBox Style="{StaticResource PaperTextBox}" Tag="问问知音：这首为什么丢了很多音？（Enter 发送）"
                         Text="{Binding AiInput, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnInputKeyDown" />
            </DockPanel>
            <TextBlock Grid.Row="2" Text="思考中……" Style="{StaticResource Muted}" Margin="4,-18,0,0" VerticalAlignment="Top"
                       Visibility="{Binding AiBusy, Converter={StaticResource BoolToVisible}}" />
        </Grid>
    </Border>
</UserControl>

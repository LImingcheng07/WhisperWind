<Window x:Class="WhisperWind.App.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WhisperWind.App.Controls"
        Title="风声 · 悬浮窗" Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        Opacity="{Binding OverlayOpacity}">
    <Window.Resources>
        <Style x:Key="MiniRound" TargetType="Button" BasedOn="{StaticResource RoundButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <Border Margin="10" CornerRadius="14" Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
            Effect="{StaticResource CardShadow}">
        <StackPanel>
            <!-- 标题（拖动区） -->
            <Border x:Name="DragArea" Background="Transparent" Padding="12,10,8,6" Cursor="SizeAll" MouseLeftButtonDown="OnDragStart">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE8A7;" Width="28" Height="26" ToolTip="打开主窗口" Click="OnOpenMain" />
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Width="28" Height="26" ToolTip="隐藏悬浮窗（F7）" Click="OnHide" />
                    </StackPanel>
                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6" Background="{StaticResource SealBrush}" Margin="0,0,10,0" VerticalAlignment="Top">
                        <TextBlock Text="风" Foreground="White" FontFamily="{StaticResource SerifFont}" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding SongTitle}" Style="{StaticResource Serif}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding GameFocused, Converter={StaticResource BoolToBrush}}" />
                            <TextBlock Text="{Binding StateText}" Style="{StaticResource Caps}" />
                            <TextBlock Text=" · " Style="{StaticResource Caps}" />
                            <TextBlock Text="{Binding GameStatusText}" Style="{StaticResource Caps}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 口琴 -->
            <Grid Margin="12,2,12,0" Height="74">
                <c:HarmonicaView x:Name="Harp" ActiveHole="{Binding ActiveHole}" SharpOn="{Binding SharpOn}" OctaveOn="{Binding OctaveOn}" OctaveDownOn="{Binding OctaveDownOn}"
                                 KeyLabels="{Binding KeyLabels}" ToolTip="点击孔可以试音" />
                <Border Width="60" Height="60" CornerRadius="30" Background="#E6C0463A" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding StateText, Converter={StaticResource EqualsToVisible}, ConverterParameter=倒计时}">
                    <TextBlock Text="{Binding Countdown}" Foreground="White" FontFamily="{StaticResource LatinFont}" FontSize="30"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <TextBlock Text="{Binding StageText}" Style="{StaticResource Muted}" Margin="14,6,14,0" TextWrapping="Wrap" FontSize="11" />

            <!-- 进度 -->
            <DockPanel Margin="12,4,12,0">
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caps}" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Run Text="{Binding PositionText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding DurationText, Mode=OneWay}" />
                </TextBlock>
                <Slider x:Name="Progress" Style="{StaticResource ProgressSlider}" Minimum="0" Maximum="{Binding DurationMs}"
                        Value="{Binding PositionMs}" IsEnabled="{Binding HasSong}"
                        PreviewMouseLeftButtonDown="OnSeekStart" PreviewMouseLeftButtonUp="OnSeekEnd" />
            </DockPanel>

            <!-- 控制 -->
            <DockPanel Margin="12,8,12,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Button Style="{StaticResource MiniRound}" Content="&#xE738;" Command="{Binding SpeedDownCommand}" ToolTip="减速" />
                    <TextBlock Style="{StaticResource Caps}" VerticalAlignment="Center" Width="36" TextAlignment="Center"
                               Text="{Binding Speed, StringFormat={}{0:0.00}x}" />
                    <Button Style="{StaticResource MiniRound}" Content="&#xE710;" Command="{Binding SpeedUpCommand}" ToolTip="加速" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource MiniRound}" Content="&#xE892;" Command="{Binding PrevCommand}" ToolTip="上一首" />
                    <Button Style="{StaticResource PlayButton}" Width="40" Height="40" FontSize="15" Content="{Binding PlayGlyph}" Margin="4,0"
                            Command="{Binding PlayGameCommand}" ToolTip="在游戏里吹奏 / 暂停（F8）" />
                    <Button Style="{StaticResource MiniRound}" Content="&#xE71A;" Command="{Binding StopCommand}" ToolTip="停止（F9）" />
                    <Button Style="{StaticResource MiniRound}" Content="&#xE893;" Margin="4,0" Command="{Binding NextCommand}" ToolTip="下一首" />
                    <Button Style="{StaticResource MiniRound}" Content="{Binding PreviewGlyph}" Command="{Binding PreviewCommand}" ToolTip="本机试听" />
                </StackPanel>
            </DockPanel>

            <!-- 曲目列表 -->
            <ToggleButton x:Name="ListToggle" Margin="12,10,12,0" Cursor="Hand">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="2,4">
                            <DockPanel>
                                <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" />
                                <TextBlock Text="曲目列表" Style="{StaticResource Caps}" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Text" Value="&#xE70E;" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <Border Margin="10,2,10,0" MaxHeight="220"
                    Visibility="{Binding IsChecked, ElementName=ListToggle, Converter={StaticResource BoolToVisible}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LibraryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}" Padding="8,5"
                                        Command="{Binding DataContext.OpenTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SourceText}" Style="{StaticResource Caps}" Margin="6,0,0,0" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock Margin="14,8,14,12" Style="{StaticResource Caps}" TextWrapping="Wrap" Text="F8 吹奏/暂停 · F9 停止 · F7 显示/隐藏 · 拖标题栏移动" />
        </StackPanel>
    </Border>
</Window>
